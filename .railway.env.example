# ──────────────────────────────────────────────────────────────────
# Railway environment variables — set these in the Railway dashboard
# for each service. NEVER commit real values to Git.
# ──────────────────────────────────────────────────────────────────

# ── BACKEND SERVICE ───────────────────────────────────────────────

# Supabase direct connection (from Connect → Direct → URI)
# Replace [YOUR-PASSWORD] with your Supabase DB password.
# asyncpg variant for the app; plain psycopg2 variant for alembic.
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.foaobkfnzmrfyhavexec.supabase.co:5432/postgres
DATABASE_SYNC_URL=postgresql://postgres:[YOUR-PASSWORD]@db.foaobkfnzmrfyhavexec.supabase.co:5432/postgres

# LLM (Gemini)
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# App
ENVIRONMENT=development
SECRET_KEY=generate-a-long-random-string-here
BACKEND_CORS_ORIGINS=https://your-frontend.up.railway.app

# Demo approvals
ENABLE_DEMO_APPROVALS=true
DEMO_REVIEWER_ID=demo-reviewer
# Demo token — allows proposal/approval actions from the deployed frontend.
# Generate with: -join ((65..90)+(97..122)+(48..57) | Get-Random -Count 32 | % {[char]$_})
DEMO_TOKEN=TxaZUMJBIo25yrSWA4PRt1HwNcKCzVF6

# ML (no model file in repo — fallback is used automatically)
ML_MODEL_PATH=ml/models/risk_model.joblib
ML_MODEL_VERSION=1.0.0

# ── FRONTEND SERVICE ───────────────────────────────────────────────

# Set this to the Railway public URL of the backend service
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
# Must match DEMO_TOKEN in the backend service
NEXT_PUBLIC_DEMO_TOKEN=TxaZUMJBIo25yrSWA4PRt1HwNcKCzVF6
