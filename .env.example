# ──────────────────────────────────────────────
# DigInSync environment variables (template)
# Copy to .env.local for local dev
# Copy to .env.production for production
# NEVER commit real values — .env.local is gitignored
# ──────────────────────────────────────────────

# Postgres credentials (used by docker-compose and backend)
POSTGRES_DB=digsync
POSTGRES_USER=digsync
POSTGRES_PASSWORD=change-me-strong-password

# Database (constructed from the vars above, or set explicitly)
DATABASE_URL=postgresql+asyncpg://digsync:change-me-strong-password@localhost:5432/digsync
DATABASE_SYNC_URL=postgresql://digsync:change-me-strong-password@localhost:5432/digsync

# LLM
LLM_PROVIDER=gemini          # gemini | watsonx
LLM_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-1.5-flash



# Map
MAP_API_KEY=your-mapbox-or-other-token

# App
ENVIRONMENT=development      # development | production
BACKEND_CORS_ORIGINS=http://localhost:3000
SECRET_KEY=change-me-in-production

# ML
ML_MODEL_PATH=backend/ml/models/risk_model.joblib
ML_MODEL_VERSION=1.0.0
